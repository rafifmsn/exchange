# Master API Kill-Switch (Set to 'true' to block all Edge Function processing & KV usage)
DISABLE_API=false

# KV Storage Kill-Switch (Set to 'true' to bypass Edge KV reads/writes and rely solely on L1 CDN Cache)
DISABLE_KV=false

# CDN Cache Control (Set to 'true' to disable s-maxage headers and force no-store)
DISABLE_CDN_CACHE=false
