---
import '../styles/globals.css';
import '../styles/starwind.css';
import Head from '../components/Head.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
---

<!doctype html>
<html lang="en" class="dark bg-background">
  <head>
    <Head {...Astro.props} />
  </head>
  <body class="min-h-screen flex justify-center">
    <div class="w-full max-w-7xl px-4 py-8">
      <slot />
    </div>
  </body>
</html>
